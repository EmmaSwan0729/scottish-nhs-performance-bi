					RETURN
					    SWITCH (
					        TRUE (),
					        _code = "S92000003", "Scotland",
					        COALESCE (
					            LOOKUPVALUE ( Ref_HealthBoard[HBName], Ref_HealthBoard[HB], _code ),
					            _code
					        )
					    )
				lineageTag: dbcb7af2-c887-4ad1-b9be-a96081d24e0f
				summarizeBy: none

				annotation SummarizationSetBy = Automatic

			column 'Board Type' =
					
					VAR _code = Dim_HealthBoard[HealthBoardCode]
					RETURN
					    SWITCH (
					        TRUE (),
					        _code = "S92000003", "Scotland",
					        LEFT ( _code, 3 ) = "S08", "Regional",
					        LEFT ( _code, 2 ) = "SB", "Special",
					        "Other"
					    )
