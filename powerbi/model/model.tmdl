			partition Fact_OngoingWaits = m
				mode: import
				source =
						let
						  Source = src_OngoingWaits,
						  QfColumns = List.Select(Table.ColumnNames(Source), each Text.EndsWith(_, "QF")),
						  ValueColumns = {"Specialty", "NumberWaiting", "NumberWaitingOver12Weeks", "Median", "90thPercentile"},
						  BlanksToNull = Table.ReplaceValue(Source, "", null, Replacer.ReplaceValue, ValueColumns & QfColumns),
						  AddedDate = Table.AddColumn(
						    BlanksToNull,
						    "PeriodEndDate",
						    each #date(
						      Number.From(Text.Start([MonthEnding], 4)),
						      Number.From(Text.Middle([MonthEnding], 4, 2)),
						      Number.From(Text.End([MonthEnding], 2))
						    ),
						    type date
						  ),
						  RemoveOldDate = Table.RemoveColumns(AddedDate, {"MonthEnding"}),
						  Typed = Table.TransformColumnTypes(
						  RemoveOldDate,
						    {
						      {"NumberWaiting", Int64.Type},
						      {"NumberWaitingOver12Weeks", Int64.Type},
						      {"Median", type number},
						      {"90thPercentile", type number}
						    }
						  ),
						  Renamed = Table.RenameColumns(
						  Typed,
						    {
						      {"HBT", "HealthBoardCode"},
						      {"Specialty", "SpecialtyCode"},
						      {"NumberWaitingOver12Weeks", "NumberOver12Weeks"},
						      {"NumberWaitingOver12WeeksQF", "NumberOver12WeeksQF"},
						      {"Median", "MedianDays"},
						      {"MedianQF", "MedianDaysQF"},
						      {"90thPercentile", "P90Days"},
						      {"90thPercentileQF", "P90DaysQF"}
						    }
						  ),
						  FillBlankSpecialty = Table.TransformColumns(#"Renamed", {{"SpecialtyCode", each if _ = null or Text.Trim(_) = "" then "UNSPEC" else _, type text}})
						in
						  FillBlankSpecialty

			annotation PBI_ResultType = Table

