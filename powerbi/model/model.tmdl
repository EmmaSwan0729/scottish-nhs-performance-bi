createOrReplace

	model Model
		culture: en-US
		defaultPowerBIDataSourceVersion: powerBI_V3
		sourceQueryCulture: en-US
		dataAccessOptions
			legacyRedirects
			returnErrorValuesAsNull

		table Fact_OngoingWaits
			lineageTag: c669cbde-fdb4-4a20-92cf-b35d9e6e3ff2

			measure 'Patients Waiting' =
					
					VAR LatestPeriod =
					    CALCULATE (
					        MAX ( Fact_OngoingWaits[PeriodEndDate] ),
					        REMOVEFILTERS ( Dim_HealthBoard ),
					        REMOVEFILTERS ( Dim_PatientType ),
					        REMOVEFILTERS ( Dim_Specialty )
					    )
					VAR BoardSelected =
					    ISFILTERED ( Dim_HealthBoard[HealthBoardCode] )
					        || ISFILTERED ( Dim_HealthBoard[Board Name] )
					        || ISFILTERED ( Dim_HealthBoard[Board Type] )
					VAR SpecialtySelected = ISFILTERED ( Dim_Specialty[SpecialtyCode] ) || ISFILTERED ( Dim_Specialty[Specialty Name] )
					VAR ScopeRows =
					    CALCULATETABLE (
					        Fact_OngoingWaits,
					        Fact_OngoingWaits[PeriodEndDate] = LatestPeriod,
					        KEEPFILTERS (
					            FILTER (
					                ALL ( Fact_OngoingWaits[HealthBoardCode] ),
					                IF (
					                    BoardSelected,
					                    Fact_OngoingWaits[HealthBoardCode] <> "S92000003",
					                    Fact_OngoingWaits[HealthBoardCode] = "S92000003"
					                )
					            )
					        ),
					        KEEPFILTERS (
					            FILTER (
					                ALL ( Fact_OngoingWaits[SpecialtyCode] ),
					                IF (
					                    SpecialtySelected,
					                    Fact_OngoingWaits[SpecialtyCode] <> "Z9",
					                    Fact_OngoingWaits[SpecialtyCode] = "Z9"
					                )
					            )
					        )
					    )
					VAR HasSuppressed =
					    NOT ISEMPTY ( FILTER ( ScopeRows, ISBLANK ( Fact_OngoingWaits[NumberWaiting] ) ) )
					RETURN
					    IF ( NOT HasSuppressed, SUMX ( ScopeRows, Fact_OngoingWaits[NumberWaiting] ) )
				formatString: 0
				lineageTag: 2cbaa34b-cdbf-42a0-b523-b6cdb8da559e

			measure '% Waiting Over 12 Weeks' =
					
					DIVIDE ( [Waiting Over 12 Weeks], [Patients Waiting] )
				formatString: 0.0%;-0.0%;0.0%
				lineageTag: c5d0c8f8-d0a1-4c3e-bf34-b06c1f4a8da1

			measure 'Waiting Over 12 Weeks' =
					
					VAR LatestPeriod =
					    CALCULATE (
					        MAX ( Fact_OngoingWaits[PeriodEndDate] ),
					        REMOVEFILTERS ( Dim_HealthBoard ),
					        REMOVEFILTERS ( Dim_PatientType ),
					        REMOVEFILTERS ( Dim_Specialty )
					    )
					VAR BoardSelected =
					    ISFILTERED ( Dim_HealthBoard[HealthBoardCode] )
					        || ISFILTERED ( Dim_HealthBoard[Board Name] )
					        || ISFILTERED ( Dim_HealthBoard[Board Type] )
					VAR SpecialtySelected = ISFILTERED ( Dim_Specialty[SpecialtyCode] ) || ISFILTERED ( Dim_Specialty[Specialty Name] )
					VAR ScopeRows =
					    CALCULATETABLE (
					        Fact_OngoingWaits,
					        Fact_OngoingWaits[PeriodEndDate] = LatestPeriod,
					        KEEPFILTERS (
					            FILTER (
					                ALL ( Fact_OngoingWaits[HealthBoardCode] ),
					                IF (
					                    BoardSelected,
					                    Fact_OngoingWaits[HealthBoardCode] <> "S92000003",
					                    Fact_OngoingWaits[HealthBoardCode] = "S92000003"
					                )
					            )
					        ),
					        KEEPFILTERS (
					            FILTER (
					                ALL ( Fact_OngoingWaits[SpecialtyCode] ),
					                IF (
					                    SpecialtySelected,
					                    Fact_OngoingWaits[SpecialtyCode] <> "Z9",
					                    Fact_OngoingWaits[SpecialtyCode] = "Z9"
					                )
					            )
					        )
					    )
					VAR HasSuppressed =
					    NOT ISEMPTY ( FILTER ( ScopeRows, ISBLANK ( Fact_OngoingWaits[NumberOver12Weeks] ) ) )
					RETURN
					    IF ( NOT HasSuppressed, SUMX ( ScopeRows, Fact_OngoingWaits[NumberOver12Weeks] ) )
				formatString: 0
				lineageTag: 73e7af62-ba57-45ef-bc99-3ff478d395a2

			measure '% Waiting Over 12 Weeks (Scotland)' =
					
					CALCULATE (
					    [% Waiting Over 12 Weeks],
					    REMOVEFILTERS ( Dim_HealthBoard )
					)
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Benchmark
				lineageTag: 222d587f-5552-4b24-8854-660b7e15b628

			measure '% Over 12 Weeks vs Scotland' =
					
					VAR BoardValue = [% Waiting Over 12 Weeks]
					VAR ScotlandValue = [% Waiting Over 12 Weeks (Scotland)]
					RETURN
					    IF (
					        NOT ISBLANK ( BoardValue ) && NOT ISBLANK ( ScotlandValue ),
					        BoardValue - ScotlandValue
					    )
				formatString: +0.0%;-0.0%;0.0%
				displayFolder: Benchmark
				lineageTag: 42148c3a-e89b-4457-b107-d04ba20c269e

				annotation PBI_FormatHint = {"isCustom":true}

			measure '% Waiting Over 12 Weeks (12M Ago)' =
					
					VAR CurrentPeriod =
					    CALCULATE (
					        MAX ( Fact_OngoingWaits[PeriodEndDate] ),
					        REMOVEFILTERS ( Dim_HealthBoard ),
					        REMOVEFILTERS ( Dim_PatientType ),
					        REMOVEFILTERS ( Dim_Specialty )
					    )
					VAR PriorPeriod = EOMONTH ( CurrentPeriod, -12 )
					RETURN
					    CALCULATE (
					        [% Waiting Over 12 Weeks],
					        REMOVEFILTERS ( Dim_Period ),
					        Dim_Period[PeriodEndDate] = PriorPeriod
					    )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Benchmark
				lineageTag: a7d86fcb-75f0-4771-bb85-b9ddd98508d0

			measure '% Over 12 Weeks Change vs 12M Ago' =
					
					VAR CurrentValue = [% Waiting Over 12 Weeks]
					VAR PriorValue = [% Waiting Over 12 Weeks (12M Ago)]
					RETURN
					    IF (
					        NOT ISBLANK ( CurrentValue ) && NOT ISBLANK ( PriorValue ),
					        CurrentValue - PriorValue
					    )
				formatString: +0.0%;-0.0%;0.0%
				displayFolder: Benchmark
				lineageTag: aa553f10-04f0-473f-9c58-317d0e119189

				annotation PBI_FormatHint = {"isCustom":true}

			measure 'Patients Waiting (12M Ago)' =
					
					VAR CurrentPeriod =
					    CALCULATE (
					        MAX ( Fact_OngoingWaits[PeriodEndDate] ),
					        REMOVEFILTERS ( Dim_HealthBoard ),
					        REMOVEFILTERS ( Dim_PatientType ),
					        REMOVEFILTERS ( Dim_Specialty )
					    )
					VAR PriorPeriod = EOMONTH ( CurrentPeriod, -12 )
					RETURN
					    CALCULATE (
					        [Patients Waiting],
					        REMOVEFILTERS ( Dim_Period ),
					        Dim_Period[PeriodEndDate] = PriorPeriod
					    )
				displayFolder: Benchmark
				lineageTag: 8c414ade-358e-49aa-9b83-a3e96746c698

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Patients Waiting Change vs 12M Ago' =
					
					DIVIDE (
					    [Patients Waiting] - [Patients Waiting (12M Ago)],
					    [Patients Waiting (12M Ago)]
					)
				formatString: " +0.0%;-0.0%;0.0%"
				displayFolder: Benchmark
				lineageTag: 53947a5d-b96b-4aec-b18d-8fc5814c6b99

				annotation PBI_FormatHint = {"isCustom":true}

			measure 'Deep Dive Title' =
					
					VAR SelectedBoard = SELECTEDVALUE ( Dim_HealthBoard[Board Name] )
					RETURN
					    IF (
					        ISBLANK ( SelectedBoard ),
					        "Health Board Deep Dive — drill through from a board on the Overview or Activity pages",
					        SelectedBoard & " — Health Board Deep Dive"
					    )
				displayFolder: Benchmark
				lineageTag: 9c71cf00-7a9c-4ae9-b564-48bafc2944a6

			measure 'Special Board Note' =
					
					IF (
					    SELECTEDVALUE ( Dim_HealthBoard[Board Type] ) = "Special",
					    "Note: The Golden Jubilee National Hospital is a national referral centre. Its case mix differs from regional boards, so comparisons with the Scotland average should be interpreted with caution.",
					    ""
					)
				lineageTag: fce85cfc-c0fb-422c-9faf-0fd731d7984b

			measure 'Patients Waiting (Pre-COVID)' = ```
					
					CALCULATE (
					    [Patients Waiting],
					    Dim_Period[PeriodEndDate] = DATE ( 2020, 2, 29 )
					)
					
					```
				formatString: 0
				displayFolder: Benchmark
				lineageTag: 1f572b4e-a8c8-41bc-aa49-20c1f5642819

			measure 'Patients Waiting vs Pre-COVID %' =
					
					VAR CurrentWaiting = [Patients Waiting]
					VAR Baseline = [Patients Waiting (Pre-COVID)]
					RETURN
					    IF (
					        NOT ISBLANK ( CurrentWaiting ) && NOT ISBLANK ( Baseline ),
					        DIVIDE ( CurrentWaiting - Baseline, Baseline )
					    )
				formatString: +0.0%;-0.0%;0.0%
				displayFolder: Benchmark
				lineageTag: a5f86a4d-0e33-4aeb-88a7-e94d8ff5d621

				annotation PBI_FormatHint = {"isCustom":true}

