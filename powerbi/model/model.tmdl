			measure 'Median Wait vs Scotland (Days)' =
					
					VAR BoardValue = [Median Wait (Days)]
					VAR ScotlandValue = [Median Wait (Days) (Scotland)]
					RETURN
					    IF (
					        NOT ISBLANK ( BoardValue ) && NOT ISBLANK ( ScotlandValue ),
					        BoardValue - ScotlandValue
					    )
				formatString: " +0;-0;0"
				displayFolder: Benchmark
				lineageTag: 9495f285-3348-48c5-87af-2fd0eab9b1c7

				annotation PBI_FormatHint = {"isCustom":true}

			measure 'P90 Wait (Days)' =
					
					VAR LatestPeriod =
					    CALCULATE (
					        MAX ( Fact_CompletedWaits[PeriodEndDate] ),
					        REMOVEFILTERS ( Dim_HealthBoard ),
					        REMOVEFILTERS ( Dim_PatientType ),
					        REMOVEFILTERS ( Dim_Specialty )
					    )
					VAR BoardSelected =
					    ISFILTERED ( Dim_HealthBoard[HealthBoardCode] )
					        || ISFILTERED ( Dim_HealthBoard[Board Name] )
					        || ISFILTERED ( Dim_HealthBoard[Board Type] )
					VAR SpecialtySelected =
					    ISFILTERED ( Dim_Specialty[SpecialtyCode] )
					        || ISFILTERED ( Dim_Specialty[Specialty Name] )
					VAR ScopeRows =
					    CALCULATETABLE (
					        Fact_CompletedWaits,
					        Fact_CompletedWaits[PeriodEndDate] = LatestPeriod,
					        KEEPFILTERS (
					            FILTER (
					                ALL ( Fact_CompletedWaits[HealthBoardCode] ),
					                IF (
					                    BoardSelected,
					                    Fact_CompletedWaits[HealthBoardCode] <> "S92000003",
					                    Fact_CompletedWaits[HealthBoardCode] = "S92000003"
					                )
					            )
					        ),
					        KEEPFILTERS (
					            FILTER (
					                ALL ( Fact_CompletedWaits[SpecialtyCode] ),
					                IF (
					                    SpecialtySelected,
					                    Fact_CompletedWaits[SpecialtyCode] <> "Z9",
					                    Fact_CompletedWaits[SpecialtyCode] = "Z9"
					                )
					            )
					        )
					    )
					RETURN
					    IF (
					        COUNTROWS ( ScopeRows ) = 1,
					        MAXX ( ScopeRows, Fact_CompletedWaits[P90Days] )
					    )
				formatString: 0
				lineageTag: 20041b51-50ff-459d-9a28-a37a76b118b0

			measure 'Quarters to Clear List' =
					
					VAR SeenPeriod =
					    CALCULATE (
					        MAX ( Fact_CompletedWaits[PeriodEndDate] ),
					        REMOVEFILTERS ( Dim_HealthBoard ),
					        REMOVEFILTERS ( Dim_PatientType ),
					        REMOVEFILTERS ( Dim_Specialty )
					    )
					VAR Waiting =
					    CALCULATE ( [Patients Waiting], Dim_Period[PeriodEndDate] = SeenPeriod )
					VAR Seen =
					    CALCULATE ( [Patients Seen], Dim_Period[PeriodEndDate] = SeenPeriod )
					RETURN
					    IF (
					        HASONEVALUE ( Dim_PatientType[PatientType] )
					            && NOT ISBLANK ( SeenPeriod )
					            && NOT ISBLANK ( Waiting )
					            && Seen > 0,
					        DIVIDE ( Waiting, Seen )
					    )
				formatString: 0.0
				lineageTag: dc74a38b-b998-46d9-b098-a5e9b21cf943

			measure 'Quarters to Clear List (Scotland)' =
					
					CALCULATE ( [Quarters to Clear List], REMOVEFILTERS ( Dim_HealthBoard ) )
				isHidden
				displayFolder: Benchmark
				lineageTag: 25142192-34b0-4900-97ae-c0d8cf8c5f6f

				changedProperty = IsHidden

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Quarters to Clear vs Scotland' =
					
					[Quarters to Clear List] - [Quarters to Clear List (Scotland)]
