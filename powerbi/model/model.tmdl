		table Fact_CompletedWaits
			lineageTag: daef1665-92c1-4557-9e6e-cc38ff436ac5

			measure 'Patients Seen' =
					
					VAR LatestPeriod =
					    CALCULATE (
					        MAX ( Fact_CompletedWaits[PeriodEndDate] ),
					        REMOVEFILTERS ( Dim_HealthBoard ),
					        REMOVEFILTERS ( Dim_PatientType ),
					        REMOVEFILTERS ( Dim_Specialty )
					    )
					VAR BoardSelected =
					    ISFILTERED ( Dim_HealthBoard[HealthBoardCode] )
					        || ISFILTERED ( Dim_HealthBoard[Board Name] )
					        || ISFILTERED ( Dim_HealthBoard[Board Type] )
					VAR SpecialtySelected =
					    ISFILTERED ( Dim_Specialty[SpecialtyCode] )
					        || ISFILTERED ( Dim_Specialty[Specialty Name] )
					VAR ScopeRows =
					    CALCULATETABLE (
					        Fact_CompletedWaits,
					        Fact_CompletedWaits[PeriodEndDate] = LatestPeriod,
					        KEEPFILTERS (
					            FILTER (
					                ALL ( Fact_CompletedWaits[HealthBoardCode] ),
					                IF (
					                    BoardSelected,
					                    Fact_CompletedWaits[HealthBoardCode] <> "S92000003",
					                    Fact_CompletedWaits[HealthBoardCode] = "S92000003"
					                )
					            )
					        ),
					        KEEPFILTERS (
					            FILTER (
					                ALL ( Fact_CompletedWaits[SpecialtyCode] ),
					                IF (
					                    SpecialtySelected,
					                    Fact_CompletedWaits[SpecialtyCode] <> "Z9",
					                    Fact_CompletedWaits[SpecialtyCode] = "Z9"
					                )
					            )
					        )
					    )
					VAR HasSuppressed =
					    NOT ISEMPTY ( FILTER ( ScopeRows, ISBLANK ( Fact_CompletedWaits[NumberSeen] ) ) )
					RETURN
					    IF ( NOT HasSuppressed, SUMX ( ScopeRows, Fact_CompletedWaits[NumberSeen] ) )
				formatString: 0
				lineageTag: 15529744-ceb2-478f-bd7d-180ba92ac6e2

			measure 'Median Wait (Days)' =
					
					VAR LatestPeriod =
					    CALCULATE (
					        MAX ( Fact_CompletedWaits[PeriodEndDate] ),
					        REMOVEFILTERS ( Dim_HealthBoard ),
					        REMOVEFILTERS ( Dim_PatientType ),
					        REMOVEFILTERS ( Dim_Specialty )
					    )
					VAR BoardSelected =
					    ISFILTERED ( Dim_HealthBoard[HealthBoardCode] )
					        || ISFILTERED ( Dim_HealthBoard[Board Name] )
					        || ISFILTERED ( Dim_HealthBoard[Board Type] )
					VAR SpecialtySelected =
					    ISFILTERED ( Dim_Specialty[SpecialtyCode] )
					        || ISFILTERED ( Dim_Specialty[Specialty Name] )
					VAR ScopeRows =
					    CALCULATETABLE (
					        Fact_CompletedWaits,
					        Fact_CompletedWaits[PeriodEndDate] = LatestPeriod,
					        KEEPFILTERS (
					            FILTER (
					                ALL ( Fact_CompletedWaits[HealthBoardCode] ),
					                IF (
					                    BoardSelected,
					                    Fact_CompletedWaits[HealthBoardCode] <> "S92000003",
					                    Fact_CompletedWaits[HealthBoardCode] = "S92000003"
					                )
					            )
					        ),
					        KEEPFILTERS (
					            FILTER (
					                ALL ( Fact_CompletedWaits[SpecialtyCode] ),
					                IF (
					                    SpecialtySelected,
					                    Fact_CompletedWaits[SpecialtyCode] <> "Z9",
					                    Fact_CompletedWaits[SpecialtyCode] = "Z9"
					                )
					            )
					        )
					    )
					RETURN
					    IF (
					        COUNTROWS ( ScopeRows ) = 1,
					        MAXX ( ScopeRows, Fact_CompletedWaits[MedianDays] )
					    )
				formatString: 0
				lineageTag: a46c9310-05f4-44eb-b17b-aaac27704051

			measure 'Median Wait (Days) (Scotland)' =
					
					CALCULATE (
					    [Median Wait (Days)],
					    REMOVEFILTERS ( Dim_HealthBoard )
					)
				displayFolder: Benchmark
