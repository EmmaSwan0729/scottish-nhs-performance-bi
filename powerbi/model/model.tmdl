						  QfColumns = List.Select(Table.ColumnNames(Source), each Text.EndsWith(_, "QF")),
						  ValueColumns = {"Specialty", "NumberSeen", "WaitedOver12Weeks", "Median", "90thPercentile"},
						  BlanksToNull = Table.ReplaceValue(Source, "", null, Replacer.ReplaceValue, ValueColumns & QfColumns),
						  AddedDate = Table.AddColumn(
						    BlanksToNull,
						    "PeriodEndDate",
						    each #date(
						      Number.From(Text.Start([QuarterEnding], 4)),
						      Number.From(Text.Middle([QuarterEnding], 4, 2)),
						      Number.From(Text.End([QuarterEnding], 2))
						    ),
						    type date
						  ),
						  RemoveOldDate = Table.RemoveColumns(AddedDate, {"QuarterEnding"}),
						  Typed = Table.TransformColumnTypes(
						    RemoveOldDate,
						    {
						      {"NumberSeen", Int64.Type},
						      {"WaitedOver12Weeks", Int64.Type},
						      {"Median", type number},
						      {"90thPercentile", type number}
						    }
						  ),
						  Renamed = Table.RenameColumns(
						    Typed,
						    {
						      {"HBT", "HealthBoardCode"},
						      {"Specialty", "SpecialtyCode"},
						      {"WaitedOver12Weeks", "NumberOver12Weeks"},
						      {"WaitedOver12WeeksQF", "NumberOver12WeeksQF"},
